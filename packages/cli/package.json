{
  "name": "obsidian-cf-sync",
  "version": "0.3.0",
  "description": "Synchronize a local Vault with CF Sync without Obsidian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shun-shobon/obsidian-cf-sync.git",
    "directory": "packages/cli"
  },
  "bin": {
    "obsidian-cf-sync": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
