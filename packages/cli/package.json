    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cf-sync/protocol": "workspace:*",
    "@cf-sync/sync-core": "workspace:*",
    "citty": "0.2.2",
    "tsdown": "0.23.0",
    "valibot": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
