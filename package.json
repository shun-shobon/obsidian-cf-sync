{
  "name": "obsidian-cf-sync",
  "version": "0.1.3",
  "private": true,
  "description": "Personal Obsidian sync with Cloudflare Workers, Durable Objects and R2",
  "license": "MIT",
  "author": "NISHIZAWA Shuntaro <me@s2n.tech>",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:plugin": "pnpm --filter @cf-sync/obsidian-plugin build",
    "build:worker": "pnpm --filter @cf-sync/worker build",
    "deploy": "pnpm --filter @cf-sync/worker deploy",
    "dev:worker": "pnpm --filter @cf-sync/worker dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck && tsc --noEmit"
  },
  "devDependencies": {
    "@cf-sync/protocol": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "^24.13.3",
    "esbuild": "0.28.1",
    "fake-indexeddb": "catalog:",
    "hono": "catalog:",
    "js-base64": "catalog:",
    "miniflare": "4.20260730.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "yjs": "catalog:"
  },
  "packageManager": "pnpm@12.3.4"
}
